# HyperLocal-Connect Environment Variables

# Backend Server Port (defaults to 5000)
PORT=5000

# MongoDB Connection URI (Optional)
# If local MongoDB is installed and running, leave as default:
# MONGODB_URI=mongodb://127.0.0.1:27017/hyperlocal_connect
#
# If you are using MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hyperlocal_connect?retryWrites=true&w=majority
#
# NOTE: If MONGODB_URI is not set or local MongoDB is not running, the application
# automatically boots an in-memory database store with the Hyderabad demo dataset!

# JWT Secret for worker authentication
JWT_SECRET=hyperlocal_connect_secure_jwt_secret_key_2026

# Environment
NODE_ENV=development
